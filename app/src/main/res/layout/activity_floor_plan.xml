<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/background"
        android:fitsSystemWindows="true">

    <!-- Shared application top bar -->

    <include
            android:id="@+id/floorPlanTopBar"
            layout="@layout/component_top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />


    <!-- Floor information -->


    <!-- Centered floor-plan content -->

    <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical">


            <!-- Interactive floor plan -->

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/spacing_24"
                    android:paddingTop="@dimen/spacing_16"
                    android:paddingEnd="@dimen/spacing_24"
                    android:paddingBottom="@dimen/spacing_12">

                <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                    <TextView
                            android:id="@+id/textFloorPlanName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceHeadlineSmall"
                            tools:text="Ground Floor" />

                    <TextView
                            android:id="@+id/textFloorPlanDeviceCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_4"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            tools:text="0 connected devices" />

                </LinearLayout>


                <!-- Add Device button -->

                <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonAddDevice"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="Add Device"
                        android:textAllCaps="false"
                        app:cornerRadius="@dimen/radius_medium"
                        app:icon="@drawable/ic_add" />

            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="520dp"
                    android:layout_marginStart="@dimen/spacing_24"
                    android:layout_marginEnd="@dimen/spacing_24"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="@dimen/radius_large"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp">

                <FrameLayout
                        android:id="@+id/floorPlanContainer"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">


                    <!-- Floor-plan image -->

                    <ImageView
                            android:id="@+id/imageFloorPlan"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="Floor-plan image"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_floor" />


                    <!-- Grid overlay -->

                    <com.example.smarthome_monitoring_system.view.floors.GridOverlayView
                            android:id="@+id/gridOverlay"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />


                    <!-- Device markers -->

                    <FrameLayout
                            android:id="@+id/deviceMarkerContainer"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                    </FrameLayout>

                </FrameLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- Device status legend -->

            <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_16"
                    android:gravity="center"
                    android:orientation="horizontal">


                <!-- ON -->

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawableStart="@drawable/status_dot_on"
                        android:drawablePadding="@dimen/spacing_8"
                        android:text="ON"
                        android:textAppearance="?attr/textAppearanceLabelLarge" />


                <!-- OFF -->

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_24"
                        android:drawableStart="@drawable/status_dot_off"
                        android:drawablePadding="@dimen/spacing_8"
                        android:text="OFF"
                        android:textAppearance="?attr/textAppearanceLabelLarge" />


                <!-- ERROR -->

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_24"
                        android:drawableStart="@drawable/status_dot_error"
                        android:drawablePadding="@dimen/spacing_8"
                        android:text="ERROR"
                        android:textAppearance="?attr/textAppearanceLabelLarge" />

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

</LinearLayout>