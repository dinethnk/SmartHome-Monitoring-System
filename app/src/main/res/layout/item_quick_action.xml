<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/quickActionCard"
    android:layout_width="112dp"
    android:layout_height="112dp"
    android:layout_marginEnd="12dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="18dp"
    app:cardElevation="1dp"
    app:strokeColor="#E8E5EC"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="12dp">

        <ImageView
            android:id="@+id/imageQuickActionIcon"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_stat_icon"
            android:contentDescription="Quick action icon"
            android:padding="10dp"
            android:src="@drawable/ic_devices"
            app:tint="#6750A4" />

        <TextView
            android:id="@+id/textQuickActionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="#211F26"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="Manage Floors" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>