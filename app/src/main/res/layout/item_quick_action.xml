<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/quickActionCard"
    android:layout_width="match_parent"
    android:layout_height="120dp"
    android:layout_marginHorizontal="6dp"
    android:layout_marginVertical="4dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="@dimen/radius_medium"
    app:cardElevation="1dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/spacing_8">

        <ImageView
            android:id="@+id/imageQuickActionIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_stat_icon"
            android:backgroundTint="@color/primary_container"
            android:contentDescription="Quick action icon"
            android:padding="12dp"
            android:src="@drawable/ic_devices"
            app:tint="@color/primary" />

        <TextView
            android:id="@+id/textQuickActionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8"
            android:gravity="center"
            android:maxLines="2"
            android:textAlignment="center"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="@color/on_background"
            android:textStyle="bold"
            tools:text="Manage Floors" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>