<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.appbar.MaterialToolbar
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/topAppBar"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="?attr/colorSurface"
    android:elevation="1dp"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    app:contentInsetEnd="0dp"
    app:contentInsetStart="0dp"
    app:contentInsetStartWithNavigation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Hamburger menu -->

        <ImageButton
            android:id="@+id/buttonMenu"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Open navigation menu"
            android:padding="14dp"
            android:src="@drawable/ic_menu"
            app:tint="?attr/colorOnSurface" />

        <!-- Centered NexHome logo -->

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/imageAppLogo"
                android:layout_width="140dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:adjustViewBounds="true"
                android:contentDescription="NexHome logo"
                android:scaleType="centerInside"
                android:src="@drawable/nexhome_logo" />

        </FrameLayout>

        <!-- Notification button -->

        <FrameLayout
            android:layout_width="52dp"
            android:layout_height="52dp">

            <ImageButton
                android:id="@+id/buttonNotifications"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Notifications"
                android:padding="14dp"
                android:src="@drawable/ic_notifications"
                app:tint="?attr/colorOnSurface" />

            <View
                android:id="@+id/notificationDot"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_notification_dot" />

        </FrameLayout>

    </LinearLayout>

</com.google.android.material.appbar.MaterialToolbar>