<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/statCard"
    android:layout_width="150dp"
    android:layout_height="145dp"
    android:layout_marginEnd="12dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="18dp"
    app:cardElevation="1dp"
    app:strokeColor="#E8E5EC"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp">

        <ImageView
            android:id="@+id/imageStatIcon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_stat_icon"
            android:contentDescription="Statistic icon"
            android:padding="8dp"
            android:src="@drawable/ic_devices"
            app:tint="#6750A4" />

        <TextView
            android:id="@+id/textStatValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="12"
            android:textColor="#211F26"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textStatTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Total Devices"
            android:textColor="#6E6872"
            android:textSize="13sp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>