<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_12"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="@dimen/radius_medium"
    app:cardElevation="0.5dp"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/spacing_16">

        <ImageView
            android:id="@+id/imageActivityIcon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_stat_icon"
            android:backgroundTint="@color/primary_container"
            android:contentDescription="Activity icon"
            android:padding="12dp"
            android:src="@drawable/ic_devices"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/primary" />

        <TextView
            android:id="@+id/textActivityTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_16"
            android:layout_marginEnd="@dimen/spacing_8"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="@color/on_background"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/textActivityTime"
            app:layout_constraintStart_toEndOf="@+id/imageActivityIcon"
            app:layout_constraintTop_toTopOf="@+id/imageActivityIcon"
            tools:text="Living Room Light" />

        <TextView
            android:id="@+id/textActivityDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_4"
            android:maxLines="2"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="@color/outline"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/textActivityTitle"
            app:layout_constraintTop_toBottomOf="@+id/textActivityTitle"
            tools:text="Device was turned ON" />

        <TextView
            android:id="@+id/textActivityTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="@color/outline"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/textActivityTitle"
            tools:text="2 min ago" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>