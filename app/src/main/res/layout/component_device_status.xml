<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="18dp"
    app:cardElevation="1dp"
    app:strokeColor="#E8E5EC"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="105dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- Device icon -->
        <ImageView
            android:id="@+id/imageDeviceStatusIcon"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:background="@drawable/bg_stat_icon"
            android:contentDescription="Device icon"
            android:padding="14dp"
            android:src="@drawable/ic_devices"
            app:tint="#6750A4" />

        <!-- Device information -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textDeviceStatusName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#211F26"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="Living Room Outlet" />

            <TextView
                android:id="@+id/textDeviceStatusLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="#716B76"
                android:textSize="13sp"
                tools:text="Ground Floor • Living Room" />

            <!-- Connection status -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/viewConnectionStatusDot"
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:background="@drawable/status_dot_on" />

                <TextView
                    android:id="@+id/textConnectionStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textColor="#00866A"
                    android:textSize="12sp"
                    tools:text="Connected" />

            </LinearLayout>

        </LinearLayout>

        <!-- Device state -->
        <TextView
            android:id="@+id/textDeviceState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_chip"
            android:paddingHorizontal="11dp"
            android:paddingVertical="6dp"
            android:textColor="#00866A"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="ON" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>