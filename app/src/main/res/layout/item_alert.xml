<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_marginBottom="12dp"

        app:cardBackgroundColor="@color/surface"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:strokeColor="@color/outline"
        app:strokeWidth="1dp">

    <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical"

            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="14dp">


        <!-- ================================================= -->
        <!-- ALERT HEADER -->
        <!-- ================================================= -->

        <LinearLayout

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:gravity="center_vertical"
                android:orientation="horizontal">


            <ImageView
                    android:id="@+id/imageAlertIcon"

                    android:layout_width="20dp"
                    android:layout_height="20dp"

                    android:contentDescription="Alert type"

                    android:src="@drawable/ic_devices" />


            <TextView
                    android:id="@+id/textAlertType"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginStart="8dp"

                    android:text="SAFETY CUTOFF"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    android:textStyle="bold" />


            <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />


            <TextView
                    android:id="@+id/textAlertTime"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="4:53 PM"

                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:alpha="0.7" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- DEVICE -->
        <!-- ================================================= -->

        <TextView
                android:id="@+id/textAlertDeviceName"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="10dp"

                android:text="Bedroom Iron"

                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="@color/on_background"
                android:textStyle="bold" />


        <!-- ================================================= -->
        <!-- MESSAGE -->
        <!-- ================================================= -->

        <TextView
                android:id="@+id/textAlertMessage"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="3dp"

                android:text="Bedroom Iron was automatically turned off."

                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/on_surface_variant"

                android:maxLines="3"
                android:ellipsize="end" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>