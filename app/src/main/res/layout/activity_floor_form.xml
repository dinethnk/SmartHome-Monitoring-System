<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/background"
        android:fitsSystemWindows="true">

    <include
            android:id="@+id/floorFormTopBar"
            layout="@layout/component_top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/spacing_24"
                android:paddingTop="@dimen/spacing_24"
                android:paddingEnd="@dimen/spacing_24"
                android:paddingBottom="@dimen/spacing_32">

            <TextView
                    android:id="@+id/textFloorFormTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add New Floor"
                    android:textAppearance="?attr/textAppearanceHeadlineMedium" />

            <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_4"
                    android:text="Enter the floor details and provide a floor-plan image URL"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

            <!-- Floor name -->

            <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutFloorName"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_24"
                    android:hint="Floor name"
                    app:boxCornerRadiusBottomEnd="@dimen/radius_medium"
                    app:boxCornerRadiusBottomStart="@dimen/radius_medium"
                    app:boxCornerRadiusTopEnd="@dimen/radius_medium"
                    app:boxCornerRadiusTopStart="@dimen/radius_medium"
                    app:startIconDrawable="@drawable/ic_edit"
                    app:startIconTint="@color/primary">

                <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editFloorName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapWords"
                        android:maxLines="1"
                        tools:text="Ground Floor"
                        android:textAppearance="?attr/textAppearanceBodyLarge" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Floor-plan heading -->

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_24"
                    android:text="Floor Plan"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="@color/primary" />

            <!-- Floor-plan URL -->

            <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutFloorPlanUrl"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_8"
                    android:hint="Floor plan image URL"
                    app:boxCornerRadiusBottomEnd="@dimen/radius_medium"
                    app:boxCornerRadiusBottomStart="@dimen/radius_medium"
                    app:boxCornerRadiusTopEnd="@dimen/radius_medium"
                    app:boxCornerRadiusTopStart="@dimen/radius_medium"
                    app:startIconDrawable="@drawable/ic_floor"
                    app:startIconTint="@color/primary">

                <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editFloorPlanUrl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textUri"
                        android:maxLines="3"
                        android:ellipsize="none"
                        tools:text="https://example.com/floor-plan.png"
                        android:textAppearance="?attr/textAppearanceBodyLarge" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Floor-plan preview -->

            <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="190dp"
                    android:layout_marginTop="@dimen/spacing_12"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="@dimen/radius_large"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/outline"
                    app:strokeWidth="1dp">

                <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                    <ImageView
                            android:id="@+id/imageFloorPlanPreview"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="Floor plan preview"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_floor" />

                    <TextView
                            android:id="@+id/textFloorPlanPlaceholder"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="Enter an image URL to preview"
                            android:textAppearance="?attr/textAppearanceBodySmall" />

                </FrameLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Grid heading -->

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_24"
                    android:text="Floor Grid"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />

            <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_4"
                    android:text="Define the rows and columns used to position devices"
                    android:textAppearance="?attr/textAppearanceBodySmall" />

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_12"
                    android:orientation="horizontal">

                <!-- Rows -->

                <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutGridRows"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/spacing_8"
                        android:layout_weight="1"
                        android:hint="Rows"
                        app:boxCornerRadiusBottomEnd="@dimen/radius_medium"
                        app:boxCornerRadiusBottomStart="@dimen/radius_medium"
                        app:boxCornerRadiusTopEnd="@dimen/radius_medium"
                        app:boxCornerRadiusTopStart="@dimen/radius_medium">

                    <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editGridRows"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:maxLength="2"
                            tools:text="8"
                            android:textAppearance="?attr/textAppearanceBodyLarge" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Columns -->

                <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutGridColumns"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_8"
                        android:layout_weight="1"
                        android:hint="Columns"
                        app:boxCornerRadiusBottomEnd="@dimen/radius_medium"
                        app:boxCornerRadiusBottomStart="@dimen/radius_medium"
                        app:boxCornerRadiusTopEnd="@dimen/radius_medium"
                        app:boxCornerRadiusTopStart="@dimen/radius_medium">

                    <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editGridColumns"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:maxLength="2"
                            tools:text="8"
                            android:textAppearance="?attr/textAppearanceBodyLarge" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <!-- Active status -->

            <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchFloorActive"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_24"
                    android:checked="true"
                    android:text="Floor is active"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />

            <!-- Save button -->

            <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonSaveFloor"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="@dimen/spacing_32"
                    android:text="Save Floor"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    app:cornerRadius="@dimen/radius_medium" />

            <!-- Cancel button -->

            <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonCancelFloor"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="@dimen/spacing_12"
                    android:text="Cancel"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    app:cornerRadius="@dimen/radius_medium"
                    app:strokeColor="@color/primary"
                    android:textColor="@color/primary" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:elevation="8dp"
        app:menu="@menu/menu_bottom_navigation" />

</LinearLayout>