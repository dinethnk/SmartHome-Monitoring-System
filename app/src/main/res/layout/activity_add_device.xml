<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/background"
        android:fitsSystemWindows="true">

    <!-- Shared top bar -->

    <include
            android:id="@+id/addDeviceTopBar"
            layout="@layout/component_top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />


    <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/spacing_24"
                android:paddingTop="@dimen/spacing_24"
                android:paddingEnd="@dimen/spacing_24"
                android:paddingBottom="@dimen/spacing_32">


            <!-- Screen title -->

            <TextView
                    android:id="@+id/textAddDeviceTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add New Device"
                    android:textAppearance="?attr/textAppearanceHeadlineMedium" />

            <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_4"
                    android:text="Enter the device details and choose its position"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />


            <!-- Device name -->

            <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutDeviceName"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_24"
                    android:hint="Device name"
                    app:boxCornerRadiusBottomEnd="@dimen/radius_medium"
                    app:boxCornerRadiusBottomStart="@dimen/radius_medium"
                    app:boxCornerRadiusTopEnd="@dimen/radius_medium"
                    app:boxCornerRadiusTopStart="@dimen/radius_medium"
                    app:startIconDrawable="@drawable/ic_edit"
                    app:startIconTint="@color/primary">

                <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editDeviceName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapWords"
                        android:maxLines="1"
                        android:textAppearance="?attr/textAppearanceBodyLarge" />

            </com.google.android.material.textfield.TextInputLayout>


            <!-- Device type -->

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_24"
                    android:text="Device Type"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="@color/primary" />

            <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutDeviceType"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_8"
                    android:hint="Select device type"
                    app:boxCornerRadiusBottomEnd="@dimen/radius_medium"
                    app:boxCornerRadiusBottomStart="@dimen/radius_medium"
                    app:boxCornerRadiusTopEnd="@dimen/radius_medium"
                    app:boxCornerRadiusTopStart="@dimen/radius_medium"
                    app:startIconDrawable="@drawable/ic_devices"
                    app:startIconTint="@color/primary">

                <AutoCompleteTextView
                        android:id="@+id/autoDeviceType"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:textAppearance="?attr/textAppearanceBodyLarge" />

            </com.google.android.material.textfield.TextInputLayout>


            <!-- Floor -->

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_24"
                    android:text="Floor"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="@color/primary" />

            <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutDeviceFloor"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_8"
                    android:hint="Selected floor"
                    app:boxCornerRadiusBottomEnd="@dimen/radius_medium"
                    app:boxCornerRadiusBottomStart="@dimen/radius_medium"
                    app:boxCornerRadiusTopEnd="@dimen/radius_medium"
                    app:boxCornerRadiusTopStart="@dimen/radius_medium"
                    app:startIconDrawable="@drawable/ic_floor"
                    app:startIconTint="@color/primary"
                    android:enabled="false">

                <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editDeviceFloor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="false"
                        android:clickable="false"
                        android:textAppearance="?attr/textAppearanceBodyLarge" />

            </com.google.android.material.textfield.TextInputLayout>


            <!-- Grid position -->

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_24"
                    android:text="Grid Position"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="@color/primary" />

            <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_4"
                    android:text="Define where the device should appear on the floor plan"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="@color/outline" />

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_12"
                    android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutDeviceRow"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/spacing_8"
                        android:layout_weight="1"
                        android:hint="Row"
                        app:boxCornerRadiusBottomEnd="@dimen/radius_medium"
                        app:boxCornerRadiusBottomStart="@dimen/radius_medium"
                        app:boxCornerRadiusTopEnd="@dimen/radius_medium"
                        app:boxCornerRadiusTopStart="@dimen/radius_medium">

                    <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editDeviceRow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:maxLength="2"
                            android:textAppearance="?attr/textAppearanceBodyLarge" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutDeviceColumn"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_8"
                        android:layout_weight="1"
                        android:hint="Column"
                        app:boxCornerRadiusBottomEnd="@dimen/radius_medium"
                        app:boxCornerRadiusBottomStart="@dimen/radius_medium"
                        app:boxCornerRadiusTopEnd="@dimen/radius_medium"
                        app:boxCornerRadiusTopStart="@dimen/radius_medium">

                    <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editDeviceColumn"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:maxLength="2"
                            android:textAppearance="?attr/textAppearanceBodyLarge" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>


            <!-- Initial status -->

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_24"
                    android:text="Initial Status"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="@color/primary" />

            <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutDeviceStatus"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_8"
                    android:hint="Select status"
                    app:boxCornerRadiusBottomEnd="@dimen/radius_medium"
                    app:boxCornerRadiusBottomStart="@dimen/radius_medium"
                    app:boxCornerRadiusTopEnd="@dimen/radius_medium"
                    app:boxCornerRadiusTopStart="@dimen/radius_medium"
                    app:startIconDrawable="@drawable/status_dot_on"
                    app:startIconTint="@color/primary">

                <AutoCompleteTextView
                        android:id="@+id/autoDeviceStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:textAppearance="?attr/textAppearanceBodyLarge" />

            </com.google.android.material.textfield.TextInputLayout>


            <!-- Save -->

            <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonSaveDevice"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="@dimen/spacing_32"
                    android:text="Save Device"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    app:cornerRadius="@dimen/radius_medium" />


            <!-- Cancel -->

            <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonCancelDevice"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="@dimen/spacing_12"
                    android:text="Cancel"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    app:cornerRadius="@dimen/radius_medium"
                    app:strokeColor="@color/primary"
                    android:textColor="@color/primary" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:elevation="8dp"
        app:menu="@menu/menu_bottom_navigation" />

</LinearLayout>