<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#FFF9FF">

    <!-- Shared top bar -->

    <include
            android:id="@+id/addDeviceTopBar"
            layout="@layout/component_top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />


    <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="32dp">


            <!-- Screen title -->

            <TextView
                    android:id="@+id/textAddDeviceTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add New Device"
                    android:textColor="#211F26"
                    android:textSize="28sp"
                    android:textStyle="bold" />

            <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Enter the device details and choose its position"
                    android:textColor="#716B76"
                    android:textSize="14sp" />


            <!-- Device name -->

            <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:hint="Device name"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusTopStart="14dp">

                <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editDeviceName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapWords"
                        android:maxLines="1" />

            </com.google.android.material.textfield.TextInputLayout>


            <!-- Device type -->

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Device Type"
                    android:textColor="#211F26"
                    android:textSize="17sp"
                    android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="Select device type"
                    app:boxBackgroundMode="outline">

                <AutoCompleteTextView
                        android:id="@+id/autoDeviceType"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none" />

            </com.google.android.material.textfield.TextInputLayout>


            <!-- Floor -->

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Floor"
                    android:textColor="#211F26"
                    android:textSize="17sp"
                    android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="Selected floor"
                    app:boxBackgroundMode="outline">

                <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editDeviceFloor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="false"
                        android:clickable="false" />

            </com.google.android.material.textfield.TextInputLayout>


            <!-- Grid position -->

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Grid Position"
                    android:textColor="#211F26"
                    android:textSize="17sp"
                    android:textStyle="bold" />

            <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Define where the device should appear on the floor plan"
                    android:textColor="#716B76"
                    android:textSize="13sp" />

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:hint="Row"
                        app:boxBackgroundMode="outline">

                    <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editDeviceRow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:maxLength="2" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:hint="Column"
                        app:boxBackgroundMode="outline">

                    <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editDeviceColumn"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:maxLength="2" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>


            <!-- Initial status -->

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Initial Status"
                    android:textColor="#211F26"
                    android:textSize="17sp"
                    android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="Select status"
                    app:boxBackgroundMode="outline">

                <AutoCompleteTextView
                        android:id="@+id/autoDeviceStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none" />

            </com.google.android.material.textfield.TextInputLayout>


            <!-- Save -->

            <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonSaveDevice"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="28dp"
                    android:text="Save Device"
                    android:textAllCaps="false"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:backgroundTint="#6750A4"
                    app:cornerRadius="16dp" />


            <!-- Cancel -->

            <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonCancelDevice"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:text="Cancel"
                    android:textAllCaps="false"
                    android:textColor="#6750A4"
                    android:textSize="15sp"
                    app:cornerRadius="16dp"
                    app:strokeColor="#6750A4" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>