<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        android:fitsSystemWindows="true"
        android:orientation="vertical"
        tools:context=".view.schedule.LightScheduleActivity">

    <!-- ===================================================== -->
    <!-- Fixed NexHome Top Bar -->
    <!-- ===================================================== -->

    <include
            android:id="@+id/lightScheduleTopBar"
            layout="@layout/component_top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />


    <!-- ===================================================== -->
    <!-- Scrollable Content -->
    <!-- ===================================================== -->

    <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:overScrollMode="never">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/spacing_24"
                android:paddingTop="@dimen/spacing_24"
                android:paddingEnd="@dimen/spacing_24"
                android:paddingBottom="@dimen/spacing_32">


            <!-- ================================================= -->
            <!-- Screen Title -->
            <!-- ================================================= -->

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Light Schedule"
                    android:textAppearance="?attr/textAppearanceHeadlineMedium" />

            <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_4"
                    android:text="Automatically turn the light on and off"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />


            <!-- ================================================= -->
            <!-- Device Information -->
            <!-- ================================================= -->

            <include
                    android:id="@+id/lightScheduleDeviceStatus"
                    layout="@layout/component_device_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_24" />


            <!-- ================================================= -->
            <!-- Power Control -->
            <!-- ================================================= -->

            <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPowerControl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_24"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="@dimen/radius_medium"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">


                    <!-- Power Control Row -->

                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="96dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="@dimen/spacing_24">

                        <ImageView
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:background="@drawable/bg_stat_icon"
                                android:backgroundTint="@color/primary_container"
                                android:contentDescription="Light power"
                                android:padding="12dp"
                                android:src="@drawable/ic_light"
                                app:tint="@color/primary" />

                        <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/spacing_16"
                                android:layout_weight="1"
                                android:orientation="vertical">

                            <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Light Power"
                                    android:textAppearance="?attr/textAppearanceTitleSmall"
                                    android:textStyle="bold" />

                            <TextView
                                    android:id="@+id/textLightPowerState"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/spacing_4"
                                    android:text="Device is OFF"
                                    android:textAppearance="?attr/textAppearanceBodySmall" />

                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/switchLightPower"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="false"
                                android:textAppearance="?attr/textAppearanceLabelLarge" />

                    </LinearLayout>


                    <!-- Divider -->

                    <View
                            android:layout_width="match_parent"
                            android:layout_height="0.5dp"
                            android:background="@color/outline"
                            android:alpha="0.2" />


                    <!-- Action Buttons -->

                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingHorizontal="@dimen/spacing_8"
                            android:paddingVertical="@dimen/spacing_4"
                            android:gravity="end">

                        <com.google.android.material.button.MaterialButton
                                android:id="@+id/buttonEditDevice"
                                style="@style/Widget.Material3.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Edit"
                                app:icon="@drawable/ic_edit"
                                app:iconSize="18dp" />

                        <com.google.android.material.button.MaterialButton
                                android:id="@+id/buttonDeleteDevice"
                                style="@style/Widget.Material3.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Delete"
                                android:textColor="@color/error"
                                app:icon="@drawable/ic_delete"
                                app:iconTint="@color/error"
                                app:iconSize="18dp" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ================================================= -->
            <!-- Schedule Settings -->
            <!-- ================================================= -->

            <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_24"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="@dimen/radius_medium"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_24">


                    <!-- Enable Schedule -->

                    <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchScheduleEnabled"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checked="false"
                            android:text="Enable automatic schedule"
                            android:textAppearance="?attr/textAppearanceTitleSmall"
                            android:textStyle="bold" />


                    <!-- ON Time Label -->

                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_24"
                            android:text="Turn ON time"
                            android:textAppearance="?attr/textAppearanceBodySmall" />


                    <!-- ON Time -->

                    <com.google.android.material.button.MaterialButton
                            android:id="@+id/buttonSelectOnTime"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginTop="@dimen/spacing_8"
                            android:gravity="start|center_vertical"
                            android:text="06:00 PM"
                            android:textAllCaps="false"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            app:cornerRadius="@dimen/radius_medium"
                            app:icon="@drawable/ic_clock"
                            app:iconTint="@color/primary"
                            app:strokeColor="@color/outline" />


                    <!-- OFF Time Label -->

                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_16"
                            android:text="Turn OFF time"
                            android:textAppearance="?attr/textAppearanceBodySmall" />


                    <!-- OFF Time -->

                    <com.google.android.material.button.MaterialButton
                            android:id="@+id/buttonSelectOffTime"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginTop="@dimen/spacing_8"
                            android:gravity="start|center_vertical"
                            android:text="06:00 AM"
                            android:textAllCaps="false"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            app:cornerRadius="@dimen/radius_medium"
                            app:icon="@drawable/ic_clock"
                            app:iconTint="@color/primary"
                            app:strokeColor="@color/outline" />


                    <!-- Save Schedule -->

                    <com.google.android.material.button.MaterialButton
                            android:id="@+id/buttonSaveSchedule"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="@dimen/spacing_16"
                            android:text="Save Schedule"
                            android:textAllCaps="false"
                            android:textStyle="bold"
                            app:backgroundTint="@color/primary"
                            app:cornerRadius="@dimen/radius_medium" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>