<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="84dp"
    android:layout_height="82dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/deviceMarkerIconContainer"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="24dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/imageDeviceMarker"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Device"
                android:padding="12dp"
                android:src="@drawable/ic_devices"
                app:tint="@color/primary" />

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/textDeviceMarkerName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_4"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textStyle="bold"
            tools:text="Light" />

    </LinearLayout>

    <View
        android:id="@+id/deviceMarkerStatus"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginStart="34dp"
        android:background="@drawable/status_dot_on" />

</FrameLayout>