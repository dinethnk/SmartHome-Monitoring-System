<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8FF"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".view.camera.CameraActivity">

    <include
        android:id="@+id/cameraTopBar"
        layout="@layout/component_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Security Camera"
            android:textColor="#211F26"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="View the latest mock camera snapshot"
            android:textColor="#716B76"
            android:textSize="14sp" />

        <include
            android:id="@+id/cameraDeviceStatus"
            layout="@layout/component_device_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp" />

        <!-- Mock snapshot -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="#1C1B20"
            app:cardCornerRadius="18dp"
            app:cardElevation="1dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/imageCameraSnapshot"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Mock camera snapshot"
                    android:scaleType="fitXY"
                    android:src="@drawable/mock_camera_snapshot" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_margin="12dp"
                    android:background="@drawable/bg_camera_label"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:text="MOCK CAMERA"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </FrameLayout>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/textSnapshotTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="Snapshot not refreshed yet"
            android:textColor="#716B76"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonRefreshSnapshot"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:text="Refresh Snapshot"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="#6750A4"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_camera"
            app:iconTint="#FFFFFF" />

    </LinearLayout>

</LinearLayout>